[Unit]
Description=viz2ai Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=viz2ai
Group=viz2ai
WorkingDirectory=/opt/viz2ai
ExecStart=/opt/viz2ai/datamanagementd \
  -socket-path /tmp/viz2ai-datamanagement.sock \
  -sqlite-path /var/lib/viz2ai/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
